{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BXR Presentation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brief_id",
    "slides",
    "design_owner",
    "quality_status"
  ],
  "properties": {
    "brief_id": {
      "type": "string"
    },
    "design_owner": {
      "const": "claude"
    },
    "quality_status": {
      "enum": [
        "draft",
        "ready-for-review",
        "approved",
        "rejected"
      ]
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slide_id",
          "role",
          "message",
          "content_refs",
          "layout_source",
          "editable_elements"
        ],
        "properties": {
          "slide_id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "cover",
              "section",
              "content",
              "comparison",
              "process",
              "timeline",
              "data",
              "map",
              "product",
              "people",
              "summary",
              "agenda",
              "other"
            ]
          },
          "message": {
            "type": "string"
          },
          "content_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "layout_source": {
            "type": "object",
            "required": [
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "approved-background",
                  "official-template",
                  "cis-approved-layout",
                  "claude-custom"
                ]
              },
              "path": {
                "type": "string"
              },
              "slide_number": {
                "type": "integer",
                "minimum": 1
              },
              "variant": {
                "type": "string",
                "description": "bxr_deck content-layout variant (bxr_deck/layouts.py), kept on regeneration with --previous-plan"
              }
            }
          },
          "editable_elements": {
            "type": "array",
            "items": {
              "enum": [
                "title",
                "subtitle",
                "body",
                "chart",
                "table",
                "diagram",
                "image",
                "page-number",
                "notes"
              ]
            }
          },
          "evidence_status": {
            "enum": [
              "provided",
              "verified",
              "uncited",
              "not-applicable"
            ]
          },
          "qa": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rendered": {
                "type": "boolean"
              },
              "overflow_checked": {
                "type": "boolean"
              },
              "master_inheritance_checked": {
                "type": "boolean"
              },
              "editability_checked": {
                "type": "boolean"
              },
              "animation_verified": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "unverified_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_inventory_sha256": {
      "type": "string"
    }
  }
}
