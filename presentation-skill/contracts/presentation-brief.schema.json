{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BXR Presentation Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "topic",
    "language",
    "audience",
    "purpose",
    "slides",
    "content"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "enum": [
        "zh-TW",
        "en",
        "jp"
      ]
    },
    "audience": {
      "enum": [
        "internal",
        "external",
        "government",
        "partners",
        "mixed"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "slides": {
      "type": "integer",
      "minimum": 3,
      "maximum": 60
    },
    "series": {
      "enum": [
        "military-tech",
        "corporate",
        "police",
        "fire",
        "custom"
      ]
    },
    "sector": {
      "enum": [
        "army",
        "navy",
        "air",
        "police",
        "fire",
        "cross-sector",
        "corporate"
      ]
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "facts"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "must_include": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "must_avoid": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "asset_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_policy": {
      "enum": [
        "provided-only",
        "allow-public-research",
        "verified-sources-only"
      ]
    },
    "speaker_notes": {
      "type": "boolean"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pptx"
      ],
      "properties": {
        "pptx": {
          "const": true
        },
        "pdf": {
          "type": "boolean"
        }
      }
    },
    "designer_notes": {
      "type": "string"
    }
  }
}
